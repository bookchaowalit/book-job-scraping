# ============================================================
# API Keys Configuration
# ============================================================
# Copy this file to .env and fill in your API keys.
#   cp .env.template .env
#
# The platform reads .env automatically on startup.
# ============================================================

# ── FIRECRAWL (AI-powered scraping, anti-bot bypass) ────────
# Get your key at: https://www.firecrawl.dev/
# Free tier: 500 pages/month
FIRECRAWL_API_KEY=

# ── JINA READER (AI-optimized web reading) ──────────────────
# Get your key at: https://jina.ai/reader
# Free tier: 1M tokens/month
JINA_API_KEY=

# ── BRAVE SEARCH (property social public-index discovery) ───
# Keep the job disabled until the subscribed plan grants result-storage rights
# and terms/PDPA purpose, retention, and human-review controls are documented.
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_STORAGE_APPROVED=0
PROPERTY_SOCIAL_RETENTION_UNTIL=
PROPERTY_SOCIAL_TERMS_BASIS_REF=

# ── TG CONDO RSS (public listing feed; contact enrichment is gated) ──
TGCONDO_CONTACT_STORAGE_APPROVED=0
TGCONDO_RETENTION_UNTIL=
TGCONDO_TERMS_BASIS_REF=

# ── PROXY (optional, for anti-bot sites) ────────────────────
# HTTP_PROXY=http://user:pass@proxy:port
# HTTPS_PROXY=http://user:pass@proxy:port

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "property-capture.v1",
  "schema_version": "property.v1",
  "title": "Property listing and public contact capture",
  "description": "A source capture row for property research. Contact signals are public-source evidence and require human review.",
  "type": "object",
  "x-privacy-class": "public_source_with_terms",
  "x-human-review-required": true,
  "required": [
    "scraped_at",
    "title",
    "url",
    "type",
    "source_channel",
    "source_platform",
    "contact_role",
    "co_agent_status",
    "lead_review_status",
    "contact_public"
  ],
  "properties": {
    "scraped_at": {"type": "string"},
    "captured_at": {"type": "string"},
    "title": {"type": "string"},
    "type": {"type": "string"},
    "listing_type": {"type": "string"},
    "url": {"type": "string", "format": "uri"},
    "price_raw": {"type": "string"},
    "price": {"type": "number", "minimum": 0},
    "bedrooms": {"type": ["string", "number", "null"]},
    "bathrooms": {"type": ["string", "number", "null"]},
    "area_sqm": {"type": ["string", "number", "null"]},
    "location": {"type": "string"},
    "description": {"type": "string"},
    "social_query": {"type": "string"},
    "date": {"type": "string"},
    "source_channel": {"type": "string", "enum": ["listing", "search", "social_search"]},
    "source_platform": {"type": "string"},
    "contact_name": {"type": "string"},
    "contact_role": {"type": "string", "enum": ["owner", "agent", "owner_or_agent", "unknown"]},
    "co_agent_status": {"type": "string", "enum": ["yes", "no", "unknown"]},
    "contact_phone": {"type": "string"},
    "contact_email": {"type": "string"},
    "contact_line": {"type": "string"},
    "contact_facebook": {"type": "string"},
    "contact_instagram": {"type": "string"},
    "contact_tiktok": {"type": "string"},
    "contact_social_urls": {"type": "string"},
    "contact_source_url": {"type": "string", "format": "uri"},
    "contact_evidence": {"type": "string"},
    "contact_confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "contact_public": {"type": "boolean"},
    "lead_review_status": {"type": "string", "enum": ["co_agent_candidate", "needs_human_review", "unqualified"]},
    "review_decision": {"type": "string", "enum": ["pending", "approved", "rejected", "needs_more_evidence"]},
    "reviewed_at": {"type": "string"},
    "reviewer_id": {"type": "string"},
    "outreach_status": {"type": "string", "enum": ["not_contacted", "approved_to_contact", "contacted", "opt_out"]},
    "retention_until": {"type": "string"},
    "terms_basis_ref": {"type": "string"}
  },
  "additionalProperties": false
}
